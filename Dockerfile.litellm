# Custom image that layers this tool pack on top of the official LiteLLM image.
# Build context is this repo's root.
#
#   docker build -f Dockerfile.litellm -t litellm-with-obsidian:local .
#   docker compose up -d --force-recreate litellm   # where your config.yaml lives
#
# `restart` does NOT pick up a rebuilt image — recreate the container.
FROM ghcr.io/berriai/litellm:main-stable

# The LiteLLM image ships its Python in /app/.venv but no pip or uv binary, so
# pip is bootstrapped with ensurepip. git comes from apk (the image is Wolfi,
# not Debian) and is needed only during the build: litellm-toolbelt — the loop
# and streaming translator this pack plugs into — is a git dependency rather
# than a PyPI release.
COPY pyproject.toml /tmp/plugin/pyproject.toml
COPY src /tmp/plugin/src
RUN apk add --no-cache git \
 && python -m ensurepip --upgrade \
 && python -m pip install --no-cache-dir /tmp/plugin \
 && apk del git \
 && rm -rf /tmp/plugin
